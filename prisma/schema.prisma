generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// AUTHENTICATION & SESSIONS
// ──────────────────────────────────────────────

enum UserRole {
  STAFF
  ADMIN
}

/// STAFF IDENTITY STORE (D6, 2026-09-05 desegregation). Admin-controlled:
/// rows are created only by an ADMIN via the staff-members flow — never by
/// public registration. Patient identity lives in PatientAccount.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // null for Google-only accounts
  googleId     String?  @unique
  role         UserRole @default(STAFF)
  /// Granular module permissions for STAFF users. Shape: { [moduleId]: 'read' | 'write' }
  /// ADMIN role bypasses this — always has full access.
  permissions  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

/// STAFF AUDIT TRAIL (security report open item #2, 2026-09-08). Append-only
/// record of every staff mutation on clinical/operational data: who, what,
/// where. No FK to users — the row must survive staff deletion; actorEmail is
/// denormalized for the same reason. Never updated, never deleted from the
/// application layer; the only sanctioned deletion is the ops-run
/// `npm run prune:audit` retention script (default 730 days, min 30) — see
/// lib/usecases/maintenance/rules.ts.
model StaffAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String
  module     String
  targetId   String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([module, createdAt])
  @@map("staff_audit_logs")
}

/// PATIENT IDENTITY STORE (D6, 2026-09-05 desegregation). Public, self-serve
/// registration. Physically separate from staff identity so a registration
/// bug can never mint a staff credential; session cookies are disjoint
/// (konooz_patient_session vs konooz_staff_session).
model PatientAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile  PatientProfile?
  sessions PatientSession[]

  @@map("patient_accounts")
}

model PatientSession {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  accountId String
  account   PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime        @default(now())

  @@index([accountId])
  @@map("patient_sessions")
}

// ──────────────────────────────────────────────
// PATIENT DATA
// ──────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

model PatientProfile {
  id        String         @id @default(cuid())
  accountId String         @unique
  account   PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Personal — AR required, EN optional
  fullNameAr     String
  fullNameEn     String?
  phone          String   // NON-UNIQUE: families share phones
  whatsappNumber String?
  dateOfBirth    String?
  gender         Gender   @default(MALE)
  bloodGroup     String?
  cityAr         String?
  cityEn         String?

  // Clinical
  allergiesAr          String[]   // Exception 3: arrays for tag-like lists; promotes to PatientAllergy table if structured metadata needed
  allergiesEn          String[]
  chronicConditionsAr  String[]
  chronicConditionsEn  String[]

  // Refractive data — Exception 2: JSON value object read/written as unit
  refractiveData Json?

  // Emergency contact
  emergencyContact Json?  // { name, relationAr, relationEn, phone }

  // Communication preferences — Exception 2: JSON value object
  communicationPreferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  prescriptions Prescription[]
  scheduledSurgeries ScheduledSurgery[]
  insurancePolicies InsurancePolicy[]
  billingInvoices HospitalBillingInvoice[]
  pacsOrders DiagnosticPacsOrder[]
  clinicalConsultations ClinicalConsultationRecord[]
  patientFlowStages PatientFlowStage[]
  surveys PatientSurvey[]

  @@index([phone])
  @@map("patient_profiles")
}

// ──────────────────────────────────────────────
// APPOINTMENTS & PRESCRIPTIONS
// ──────────────────────────────────────────────

enum AppointmentStatus {
  scheduled
  confirmed
  in_queue
  completed
  cancelled
  no_show
}

/// Why an appointment was cancelled or marked no-show. Powers the
/// cancellation Pareto report; free-text nuance lives in cancelNote.
enum AppointmentCancelReason {
  patient_request
  clinic_decision
  duplicate
  rescheduled
  other
}

enum AppointmentSource {
  PATIENT_REQUEST
  STAFF_ENTRY
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String?
  patient      PatientProfile?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       Doctor?           @relation(fields: [doctorId], references: [id])
  roomId       String?
  room         Room?             @relation(fields: [roomId], references: [id])
  ticketNumber String            @unique
  // Snapshot at booking time (Exception 1: snapshot semantics)
  doctorDisplayNameAr String?
  doctorDisplayNameEn String?
  specialtyAr  String?
  specialtyEn  String?
  date         DateTime
  time         String
  status       AppointmentStatus @default(scheduled)
  source       AppointmentSource @default(PATIENT_REQUEST)
  /// Set only when status is cancelled or no_show (enforced in rules.ts).
  cancelReason AppointmentCancelReason?
  cancelNote   String?
  locationAr   String?
  locationEn   String?
  instructionsAr String?
  instructionsEn String?
  /// Dynamic intake data collected via department intakeSchema.
  /// Base fields (name/phone/email/specialty/date/time) live in
  /// dedicated columns above; this holds the schema-driven extras.
  intakeData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status, date])
  @@map("appointments")
}

model Prescription {
  id        String         @id @default(cuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String?
  doctor    Doctor?        @relation(fields: [doctorId], references: [id])
  medicationNameAr String?
  medicationNameEn String?
  dosageAr  String?
  dosageEn  String?
  instructionsAr String?
  instructionsEn String?
  issuedDate DateTime
  expiryDate DateTime?
  notesAr   String?
  notesEn   String?
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("prescriptions")
}

// ──────────────────────────────────────────────
// HOSPITAL RESOURCES — Epic 4
// ──────────────────────────────────────────────

enum StaffCategory {
  surgeon
  consultant
  resident
  nurse
  technician
  admin
}

model StaffMember {
  id            String       @id @default(cuid())
  nameAr        String
  nameEn        String?
  roleAr        String       @default("")
  roleEn        String?
  category      StaffCategory @default(nurse)
  departmentAr  String       @default("")
  departmentEn  String?
  status        String       @default("on_duty")
  roomAssignedAr String      @default("")
  roomAssignedEn String?
  shift         String       @default("morning")
  patientCountToday   Int    @default(0)
  surgeriesCountToday Int    @default(0)
  phone         String?
  email         String?
  avatar        String?
  rating        Float        @default(4.5)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("staff_members")
}

enum DoctorType {
  VISITING
  LOCAL
}

enum PublicAvailability {
  AVAILABLE_NOW
  UPCOMING_VISIT
  REGULAR
}

model Doctor {
  id           String        @id @default(cuid())
  fullNameAr   String
  fullNameEn   String?
  specialtyAr  String
  specialtyEn  String?
  category     StaffCategory @default(consultant)
  phone        String?
  email        String?
  isAvailable  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Public listing fields (BCK-095) — single source for marketing site
  titleAr          String            @default("")
  titleEn          String?
  doctorType       DoctorType        @default(LOCAL)
  specialtyId      String            @default("")
  originAr         String            @default("")
  originEn         String?
  universityAr     String            @default("")
  universityEn     String?
  availability     PublicAvailability @default(REGULAR)
  visitScheduleAr  String            @default("")
  visitScheduleEn  String?
  experienceYears  Int               @default(0)
  surgeriesCount   String            @default("0")
  photoSeed        String            @default("")
  highlightsAr     String[]          @default([])
  highlightsEn     String[]          @default([])

  appointments Appointment[]
  surgeries    ScheduledSurgery[] @relation("SurgeonSurgeries")
  prescriptions Prescription[]

  @@map("doctors")
}

enum RoomType {
  operating_theater
  outpatient_clinic
  diagnostic_suite
  recovery_ward
  laser_room
}

enum RoomStatus {
  occupied_surgery
  in_consultation
  ready_clean
  sterilizing
  maintenance
}

model Room {
  id          String     @id @default(cuid())
  code        String     @unique
  nameAr      String
  nameEn      String?
  type        RoomType
  status      RoomStatus @default(ready_clean)
  floorAr     String     @default("")
  floorEn     String?
  currentDoctorAr     String?
  currentDoctorEn     String?
  currentPatientId    String?
  currentProcedureAr  String?
  currentProcedureEn  String?
  sterilizationStatus String  @default("unknown")
  airPressureHepa     String  @default("unknown")
  tempCelsius         Float?
  humidityPercent     Float?
  capacity            Int     @default(1)
  occupiedCount       Int     @default(0)
  // Denormalized live-occupancy mirror (documented exception 4):
  // kept in sync with active appointments/surgeries by the rooms use case
  // for O(1) dashboard board reads. Authoritative state stays in
  // appointments/beds; this is a display cache.
  mainDeviceAssignedAr String @default("")
  mainDeviceAssignedEn String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  appointments Appointment[]
  surgeries    ScheduledSurgery[]

  @@map("rooms")
}

// ──────────────────────────────────────────────
// SURGERIES — Epic 4
// ──────────────────────────────────────────────

enum SurgeryStatus {
  scheduled
  in_progress
  pre_op_prep
  in_or
  post_op_recovery
  completed
  cancelled
}

model ScheduledSurgery {
  id          String         @id @default(cuid())
  patientId   String?
  patient     PatientProfile? @relation(fields: [patientId], references: [id])
  surgeonId   String?
  surgeon     Doctor?        @relation("SurgeonSurgeries", fields: [surgeonId], references: [id])
  roomId      String?
  room        Room?          @relation(fields: [roomId], references: [id])
  procedureAr String
  procedureEn String?
  scheduledAt DateTime
  durationMin Int            @default(60)
  status      SurgeryStatus  @default(scheduled)
  notesAr     String?
  notesEn     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Scheduling-time snapshot (Exception 1) — dashboard DTO fields
  patientNameAr String @default("")
  patientNameEn String?
  patientPhone  String @default("")
  patientAge    Int?
  gender        Gender?
  surgeonNameAr String @default("")
  surgeonNameEn String?
  specialtyId   String @default("")
  roomCode      String @default("")
  time          String @default("")
  priority      String @default("elective")
  anesthesiaTypeAr String @default("")
  anesthesiaTypeEn String?

  consumables SurgeryConsumableUsage[]

  @@index([surgeonId])
  @@index([scheduledAt])
  @@map("scheduled_surgeries")
}

// ──────────────────────────────────────────────
// OPS DOMAINS — Epic 5
// ──────────────────────────────────────────────

enum DeviceStatus {
  operational
  in_use
  under_calibration
  maintenance_scheduled
  offline_alert
}

model Equipment {
  id            String       @id @default(cuid())
  nameAr        String
  nameEn        String?
  modelNumber   String?
  status        DeviceStatus @default(operational)
  locationAr    String?
  locationEn    String?
  calibrationDue DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Operational fields (dashboard) — single source of truth
  brand             String  @default("")
  serialNumber      String  @default("")
  departmentAr      String  @default("")
  departmentEn      String?
  roomCode          String  @default("")
  uptimePercentage  Float   @default(100)
  totalProceduresRun Int    @default(0)
  lastMaintenanceDate String?
  nextServiceDue    String?
  firmwareVersion   String  @default("")
  technicianInChargeAr String @default("")
  technicianInChargeEn String?
  healthScore       Int     @default(100)
  notesAr           String  @default("")
  notesEn           String?

  @@map("equipment")
}

enum WardType {
  pacu_recovery
  daycare_suite
  vip_inpatient
}

enum BedStatus {
  occupied
  ready_clean
  dirty_cleaning
  reserved
}

model Bed {
  id        String     @id @default(cuid())
  bedNumber String     @unique
  wardType  WardType
  wardNameAr String    @default("")
  wardNameEn String?
  floorAr   String     @default("")
  floorEn   String?
  status    BedStatus  @default(ready_clean)

  // Denormalized occupant snapshot (documented exception 1 family):
  // written at bed-assignment time so the ward board renders without joins.
  // patientId is intentionally a bare string — beds can hold walk-in
  // patients without a portal account; align with the nullable-FK pattern
  // when bed assignment is wired to PatientProfile.
  patientId String?
  patientNameAr String?
  patientNameEn String?
  patientAge Int?
  assignedDoctorAr String?
  assignedDoctorEn String?
  surgeryPerformedAr String?
  surgeryPerformedEn String?
  admissionTime String?
  estimatedDischargeTime String?

  // Bedside vitals
  bloodPressure String?
  heartRateBpm Int?
  spO2Percent Int?
  tempCelsius Float?
  painScore Int?
  nurseInChargeAr String?
  nurseInChargeEn String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("beds")
}

enum PatientFlowStageType {
  reception
  triage
  diagnostics
  consultation
  pre_op
  in_or
  pacu
  procedure
  waiting_discharge
  discharged
}

model PatientFlowStage {
  id          String              @id @default(cuid())
  /// Synthetic walk-in correlation key — NOT a PatientProfile id. Real-account
  /// linkage goes through patientRef.
  patientId   String
  patientRefId String?
  patientRef  PatientProfile? @relation(fields: [patientRefId], references: [id], onDelete: SetNull)
  stageType   PatientFlowStageType
  enteredAt   DateTime            @default(now())
  exitedAt    DateTime?
  notesAr     String?
  notesEn     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([enteredAt])
  @@map("patient_flow_stages")
}

enum ConsumableCategory {
  iol_lens
  viscoelastic
  laser_pack
  surgical_gas
  microsuture
  phaco_pack
}

/// CSSD instrument-tray lifecycle. The dashboard sterile-sets telemetry is
/// derived from these rows (ready count vs total) — never hardcoded.
enum SterileSetStatus {
  ready
  in_use
  sterilizing
  dirty
}

model SterileSet {
  id           String           @id @default(cuid())
  nameAr       String
  nameEn       String?
  status       SterileSetStatus @default(ready)
  sterilizedAt DateTime?
  expiresAt    DateTime?
  notesAr      String?
  notesEn      String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([status])
  @@map("sterile_sets")
}

/// Dashboard ops-activity feed (header notifications). Append-only log;
/// demo rows are seeded until real event emission is wired into use cases.
enum OpsActivityLevel {
  info
  success
  warning
}

model OpsActivityLog {
  id        String           @id @default(cuid())
  messageAr String
  messageEn String?
  level     OpsActivityLevel @default(info)
  createdAt DateTime         @default(now())

  @@index([createdAt])
  @@map("ops_activity_logs")
}

model ConsumableType {
  id         String            @id @default(cuid())
  nameAr     String
  nameEn     String?
  category   ConsumableCategory
  unitAr     String
  unitEn     String?
  stockLevel Int               @default(0)
  lowStockThreshold Int        @default(10)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Inventory fields (dashboard stock board). Cost column is Decimal(12,2)
  // so stock valuation stays exact; DTO mapper converts to JS number.
  // expiryDate is a real DATE so expiry-radar math (days remaining, sort by
  // soonest) is exact; the string ISO form persists at the API boundary.
  brand        String  @default("")
  reorderStatus String @default("optimal")
  batchLot     String  @default("")
  expiryDate   DateTime?
  locationAr   String  @default("")
  locationEn   String?
  unitCostLYD  Decimal @db.Decimal(12, 2) @default(0)

  usages SurgeryConsumableUsage[]

  @@map("consumable_types")
}

model SurgeryConsumableUsage {
  id              String         @id @default(cuid())
  surgeryId       String
  surgery         ScheduledSurgery @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  consumableTypeId String
  consumableType  ConsumableType  @relation(fields: [consumableTypeId], references: [id])
  quantityUsed    Int            @default(1)
  createdAt       DateTime       @default(now())

  @@unique([surgeryId, consumableTypeId])
  @@map("surgery_consumable_usage")
}

// ──────────────────────────────────────────────
// PEOPLE & CLINICAL — Epic 6
// ──────────────────────────────────────────────

enum ShiftType {
  morning
  evening
  night_call
  full_day
}

enum AttendanceStatus {
  present
  absent
  on_leave
  late
  present_ontime
  in_surgery
  on_call
}

model StaffAttendanceRecord {
  id         String           @id @default(cuid())
  staffId    String?
  staffNameAr String
  staffNameEn String?
  shiftType  ShiftType
  date       DateTime
  status     AttendanceStatus @default(present)
  checkInTime String?
  checkOutTime String?
  notesAr    String?
  notesEn    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Personnel board fields
  roleAr      String  @default("")
  roleEn      String?
  avatar      String  @default("")
  category    StaffCategory @default(consultant)
  departmentAr String @default("")
  departmentEn String?
  shiftNameAr String  @default("")
  shiftNameEn String?
  shiftTiming String  @default("")
  scheduledTime String @default("")
  punctualityMinutes Int @default(0)
  overtimeHours Float  @default(0)
  monthlyAttendanceRate Float @default(100)
  badgeCode   String  @default("")

  @@index([date])
  @@map("staff_attendance_records")
}

model ClinicalConsultationRecord {
  id          String   @id @default(cuid())
  /// Synthetic walk-in correlation key (`PT-<ts>` or supplied code) — NOT a
  /// PatientProfile id. Real-account linkage goes through patientRef.
  patientId   String
  patientRefId String?
  patientRef  PatientProfile? @relation(fields: [patientRefId], references: [id], onDelete: SetNull)
  patientNameAr String
  patientNameEn String?
  doctorNameAr String
  doctorNameEn String?
  date        DateTime
  chiefComplaintAr String?
  chiefComplaintEn String?
  diagnosisAr String?
  diagnosisEn String?
  notesAr     String?
  notesEn     String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // EMR fields (ophthalmic consultation template)
  ticketNumber String  @default("")
  patientAge   Int?
  patientGender Gender?
  patientPhone String  @default("")
  clinicRoom   String  @default("")
  visitDate    String?
  visitTime    String  @default("")
  status       String  @default("completed")
  visualAcuityOD_Unaided String @default("")
  visualAcuityOD_BCVA    String @default("")
  visualAcuityOS_Unaided String @default("")
  visualAcuityOS_BCVA    String @default("")
  iopOD_mmHg   Int?
  iopOS_mmHg   Int?
  corneaAr            String?
  corneaEn            String?
  anteriorChamberAr   String?
  anteriorChamberEn   String?
  lensStatusAr        String?
  lensStatusEn        String?
  fundusMaculaAr      String?
  fundusMaculaEn      String?
  icdCode             String  @default("")
  surgicalPlan        String?
  nextFollowUpDate    String?

  items OphthalmicPrescriptionItem[]

  @@index([patientId])
  @@index([date])
  @@map("clinical_consultation_records")
}

model OphthalmicPrescriptionItem {
  id             String   @id @default(cuid())
  consultationId String
  consultation   ClinicalConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  odSphere  String?
  odCyl     String?
  odAxis    String?
  osSphere  String?
  osCyl     String?
  osAxis    String?
  addition  String?
  ipd       String?
  notesAr   String?
  notesEn   String?
  createdAt DateTime @default(now())

  // e-Prescription fields
  drugNameAr String  @default("")
  drugNameEn String?
  category   String  @default("lubricant")
  eye        String  @default("OU")
  dosage     String  @default("")
  frequency  String  @default("")
  durationDays Int   @default(0)
  instructionsAr String?
  instructionsEn String?
  taperingSchedule String[] @default([])

  @@map("ophthalmic_prescription_items")
}

// ──────────────────────────────────────────────
// MONEY & IMAGING — Epic 7
// ──────────────────────────────────────────────

model InsuranceProvider {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coveragePercentage Float  @default(0)
  preAuthRequired    Boolean @default(false)
  contactDesk        String  @default("")
  logo               String  @default("")

  policies InsurancePolicy[]

  @@map("insurance_providers")
}

model InsurancePolicy {
  id         String   @id @default(cuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   InsuranceProvider @relation(fields: [providerId], references: [id])
  policyNo   String
  expiryDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([patientId, providerId])
  @@map("insurance_policies")
}

enum InvoiceStatus {
  pending
  paid
  partially_paid
  cancelled
  pending_insurance
  pre_auth_approved
  draft
}

model HospitalBillingInvoice {
  id         String        @id @default(cuid())
  /// Synthetic walk-in correlation key (`PT-<ticket>`) — NOT a PatientProfile
  /// id. Real-account linkage goes through the optional patientRef below.
  patientId  String
  patientRefId String?
  patientRef PatientProfile? @relation(fields: [patientRefId], references: [id], onDelete: SetNull)
  patientNameAr String?
  patientNameEn String?
  serviceAr  String
  serviceEn  String?
  /// Invoice total in LYD. DECIMAL(12,2): supports up to 9,999,999,999.99
  /// — ample for ophthalmic billing; exact money arithmetic, no float drift.
  amount     Decimal       @db.Decimal(12, 2)
  currency   String        @default("LYD")
  status     InvoiceStatus @default(pending)
  issuedDate DateTime
  paidDate   DateTime?
  notesAr    String?
  notesEn    String?
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Invoice breakdown (dashboard billing board). All money columns share
  // Decimal(12,2) with `amount` — exact arithmetic, one type for money.
  // DTO mappers convert to JS numbers at the lib/dashboard boundary.
  invoiceNumber String @default("")
  ticketNumber  String @default("")
  insuranceNameAr String @default("")
  insuranceNameEn String?
  surgeonFeeLYD      Decimal @db.Decimal(12, 2) @default(0)
  orFacilityFeeLYD   Decimal @db.Decimal(12, 2) @default(0)
  anesthesiaFeeLYD   Decimal @db.Decimal(12, 2) @default(0)
  lensOrDeviceFeeLYD Decimal @db.Decimal(12, 2) @default(0)
  consumablesFeeLYD  Decimal @db.Decimal(12, 2) @default(0)
  totalGrossLYD      Decimal @db.Decimal(12, 2) @default(0)
  insuranceCoveredLYD Decimal @db.Decimal(12, 2) @default(0)
  patientCoPayLYD     Decimal @db.Decimal(12, 2) @default(0)

  @@index([patientId])
  @@index([issuedDate])
  @@index([status, issuedDate])
  paymentTransactions PaymentTransaction[]
  @@map("hospital_billing_invoices")
}

enum PaymentTransactionStatus {
  /// Session opened, awaiting OTP verification or hosted-page completion.
  pending
  /// Gateway confirmed the payment (webhook or verify response).
  paid
  failed
  expired
  refunded
  voided
  /// Staff abandoned the collection attempt before completion.
  cancelled
}

/// One DPay payment attempt against an invoice. Multiple rows per invoice are
/// valid (retries, partial payments across wallets). `paid` rows sum to the
/// invoice's collected amount — refunds/voids are excluded, never mutated.
model PaymentTransaction {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       HospitalBillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  /// DPay `session_id` — unique anchor for idempotency (`session_id + event`
  /// is the webhook idempotency key per DPay docs).
  dpaySessionId Int      @unique
  payMethod     String
  status        PaymentTransactionStatus @default(pending)

  /// Requested amount in LYD (the amount DPay was asked to charge).
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("LYD")

  /// DPay transaction reference on success (`sb_txn_...` prefix in sandbox).
  txId          String?
  receiptUrl    String?
  /// Gateway-reported payer account/mask when returned — support/audit only.
  payerAccount  String?
  failureReason String?

  /// Staff email when a human confirmed (assisted OTP flow) — audit trail.
  confirmedBy   String?
  /// Last webhook delivery seen for this session (event name + time).
  lastWebhookEvent String?
  lastWebhookAt    DateTime?
  lastPollAt       DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([invoiceId])
  @@index([status])
  @@map("payment_transactions")
}

enum PacsOrderStatus {
