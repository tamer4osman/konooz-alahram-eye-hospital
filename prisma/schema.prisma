generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// AUTHENTICATION & SESSIONS
// ──────────────────────────────────────────────

enum UserRole {
  PATIENT
  STAFF
  ADMIN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // null for Google-only accounts
  googleId     String?  @unique
  role         UserRole @default(PATIENT)
  /// Granular module permissions for STAFF users. Shape: { [moduleId]: 'read' | 'write' }
  /// ADMIN role bypasses this — always has full access.
  permissions  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientProfile PatientProfile?
  sessions       Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

// ──────────────────────────────────────────────
// PATIENT DATA
// ──────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

model PatientProfile {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Personal — AR required, EN optional
  fullNameAr     String
  fullNameEn     String?
  phone          String   // NON-UNIQUE: families share phones
  whatsappNumber String?
  dateOfBirth    String?
  gender         Gender   @default(MALE)
  bloodGroup     String?
  cityAr         String?
  cityEn         String?

  // Clinical
  allergiesAr          String[]   // Exception 3: arrays for tag-like lists; promotes to PatientAllergy table if structured metadata needed
  allergiesEn          String[]
  chronicConditionsAr  String[]
  chronicConditionsEn  String[]

  // Refractive data — Exception 2: JSON value object read/written as unit
  refractiveData Json?

  // Emergency contact
  emergencyContact Json?  // { name, relationAr, relationEn, phone }

  // Communication preferences — Exception 2: JSON value object
  communicationPreferences Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments  Appointment[]
  prescriptions Prescription[]
  scheduledSurgeries ScheduledSurgery[]
  insurancePolicies InsurancePolicy[]

  @@index([phone])
  @@map("patient_profiles")
}

// ──────────────────────────────────────────────
// APPOINTMENTS & PRESCRIPTIONS
// ──────────────────────────────────────────────

enum AppointmentStatus {
  scheduled
  confirmed
  in_queue
  completed
  cancelled
}

enum AppointmentSource {
  PATIENT_REQUEST
  STAFF_ENTRY
}

model Appointment {
  id           String            @id @default(cuid())
  patientId    String?
  patient      PatientProfile?   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String?
  doctor       Doctor?           @relation(fields: [doctorId], references: [id])
  roomId       String?
  room         Room?             @relation(fields: [roomId], references: [id])
  ticketNumber String            @unique
  // Snapshot at booking time (Exception 1: snapshot semantics)
  doctorDisplayNameAr String?
  doctorDisplayNameEn String?
  specialtyAr  String?
  specialtyEn  String?
  date         DateTime
  time         String
  status       AppointmentStatus @default(scheduled)
  source       AppointmentSource @default(PATIENT_REQUEST)
  locationAr   String?
  locationEn   String?
  instructionsAr String?
  instructionsEn String?
  /// Dynamic intake data collected via department intakeSchema.
  /// Base fields (name/phone/email/specialty/date/time) live in
  /// dedicated columns above; this holds the schema-driven extras.
  intakeData    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@map("appointments")
}

model Prescription {
  id        String         @id @default(cuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String?
  doctor    Doctor?        @relation(fields: [doctorId], references: [id])
  medicationNameAr String?
  medicationNameEn String?
  dosageAr  String?
  dosageEn  String?
  instructionsAr String?
  instructionsEn String?
  issuedDate DateTime
  expiryDate DateTime?
  notesAr   String?
  notesEn   String?
  createdBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId])
  @@map("prescriptions")
}

// ──────────────────────────────────────────────
// HOSPITAL RESOURCES — Epic 4
// ──────────────────────────────────────────────

enum StaffCategory {
  surgeon
  consultant
  resident
  nurse
  technician
  admin
}

model StaffMember {
  id            String       @id @default(cuid())
  nameAr        String
  nameEn        String?
  roleAr        String       @default("")
  roleEn        String?
  category      StaffCategory @default(nurse)
  departmentAr  String       @default("")
  departmentEn  String?
  status        String       @default("on_duty")
  roomAssignedAr String      @default("")
  roomAssignedEn String?
  shift         String       @default("morning")
  patientCountToday   Int    @default(0)
  surgeriesCountToday Int    @default(0)
  phone         String?
  email         String?
  avatar        String?
  rating        Float        @default(4.5)
  isActive      Boolean      @default(true)
  sortOrder     Int          @default(0)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("staff_members")
}

enum DoctorType {
  VISITING
  LOCAL
}

enum PublicAvailability {
  AVAILABLE_NOW
  UPCOMING_VISIT
  REGULAR
}

model Doctor {
  id           String        @id @default(cuid())
  fullNameAr   String
  fullNameEn   String?
  specialtyAr  String
  specialtyEn  String?
  category     StaffCategory @default(consultant)
  phone        String?
  email        String?
  isAvailable  Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Public listing fields (BCK-095) — single source for marketing site
  titleAr          String            @default("")
  titleEn          String?
  doctorType       DoctorType        @default(LOCAL)
  specialtyId      String            @default("")
  originAr         String            @default("")
  originEn         String?
  universityAr     String            @default("")
  universityEn     String?
  availability     PublicAvailability @default(REGULAR)
  visitScheduleAr  String            @default("")
  visitScheduleEn  String?
  experienceYears  Int               @default(0)
  surgeriesCount   String            @default("0")
  photoSeed        String            @default("")
  highlightsAr     String[]          @default([])
  highlightsEn     String[]          @default([])

  appointments Appointment[]
  surgeries    ScheduledSurgery[] @relation("SurgeonSurgeries")
  prescriptions Prescription[]

  @@map("doctors")
}

enum RoomType {
  operating_theater
  outpatient_clinic
  diagnostic_suite
  recovery_ward
  laser_room
}

enum RoomStatus {
  occupied_surgery
  in_consultation
  ready_clean
  sterilizing
  maintenance
}

model Room {
  id          String     @id @default(cuid())
  code        String     @unique
  nameAr      String
  nameEn      String?
  type        RoomType
  status      RoomStatus @default(ready_clean)
  floorAr     String     @default("")
  floorEn     String?
  currentDoctorAr     String?
  currentDoctorEn     String?
  currentPatientId    String?
  currentProcedureAr  String?
  currentProcedureEn  String?
  sterilizationStatus String  @default("unknown")
  airPressureHepa     String  @default("unknown")
  tempCelsius         Float?
  humidityPercent     Float?
  capacity            Int     @default(1)
  occupiedCount       Int     @default(0)
  mainDeviceAssignedAr String @default("")
  mainDeviceAssignedEn String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  appointments Appointment[]
  surgeries    ScheduledSurgery[]

  @@map("rooms")
}

// ──────────────────────────────────────────────
// SURGERIES — Epic 4
// ──────────────────────────────────────────────

enum SurgeryStatus {
  scheduled
  in_progress
  pre_op_prep
  in_or
  post_op_recovery
  completed
  cancelled
}

model ScheduledSurgery {
  id          String         @id @default(cuid())
  patientId   String?
  patient     PatientProfile? @relation(fields: [patientId], references: [id])
  surgeonId   String?
  surgeon     Doctor?        @relation("SurgeonSurgeries", fields: [surgeonId], references: [id])
  roomId      String?
  room        Room?          @relation(fields: [roomId], references: [id])
  procedureAr String
  procedureEn String?
  scheduledAt DateTime
  durationMin Int            @default(60)
  status      SurgeryStatus  @default(scheduled)
  notesAr     String?
  notesEn     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Scheduling-time snapshot (Exception 1) — dashboard DTO fields
  patientNameAr String @default("")
  patientNameEn String?
  patientPhone  String @default("")
  patientAge    Int?
  gender        Gender?
  surgeonNameAr String @default("")
  surgeonNameEn String?
  specialtyId   String @default("")
  roomCode      String @default("")
  time          String @default("")
  priority      String @default("elective")
  anesthesiaTypeAr String @default("")
  anesthesiaTypeEn String?

  consumables SurgeryConsumableUsage[]

  @@index([surgeonId])
  @@index([scheduledAt])
  @@map("scheduled_surgeries")
}

// ──────────────────────────────────────────────
// OPS DOMAINS — Epic 5
// ──────────────────────────────────────────────

enum DeviceStatus {
  operational
  in_use
  under_calibration
  maintenance_scheduled
  offline_alert
}

model Equipment {
  id            String       @id @default(cuid())
  nameAr        String
  nameEn        String?
  modelNumber   String?
  status        DeviceStatus @default(operational)
  locationAr    String?
  locationEn    String?
  calibrationDue DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Operational fields (dashboard) — single source of truth
  brand             String  @default("")
  serialNumber      String  @default("")
  departmentAr      String  @default("")
  departmentEn      String?
  roomCode          String  @default("")
  uptimePercentage  Float   @default(100)
  totalProceduresRun Int    @default(0)
  lastMaintenanceDate String?
  nextServiceDue    String?
  firmwareVersion   String  @default("")
  technicianInChargeAr String @default("")
  technicianInChargeEn String?
  healthScore       Int     @default(100)
  notesAr           String  @default("")
  notesEn           String?

  @@map("equipment")
}

enum WardType {
  pacu_recovery
  daycare_suite
  vip_inpatient
}

enum BedStatus {
  occupied
  ready_clean
  dirty_cleaning
  reserved
}

model Bed {
  id        String     @id @default(cuid())
  bedNumber String     @unique
  wardType  WardType
  wardNameAr String    @default("")
  wardNameEn String?
  floorAr   String     @default("")
  floorEn   String?
  status    BedStatus  @default(ready_clean)

  // Occupant snapshot
  patientId String?
  patientNameAr String?
  patientNameEn String?
  patientAge Int?
  assignedDoctorAr String?
  assignedDoctorEn String?
  surgeryPerformedAr String?
  surgeryPerformedEn String?
  admissionTime String?
  estimatedDischargeTime String?

  // Bedside vitals
  bloodPressure String?
  heartRateBpm Int?
  spO2Percent Int?
  tempCelsius Float?
  painScore Int?
  nurseInChargeAr String?
  nurseInChargeEn String?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("beds")
}

enum PatientFlowStageType {
  reception
  triage
  diagnostics
  consultation
  pre_op
  in_or
  pacu
  procedure
  waiting_discharge
  discharged
}

model PatientFlowStage {
  id          String              @id @default(cuid())
  patientId   String
  stageType   PatientFlowStageType
  enteredAt   DateTime            @default(now())
  exitedAt    DateTime?
  notesAr     String?
  notesEn     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([patientId])
  @@map("patient_flow_stages")
}

enum ConsumableCategory {
  iol_lens
  viscoelastic
  laser_pack
  surgical_gas
  microsuture
  phaco_pack
}

model ConsumableType {
  id         String            @id @default(cuid())
  nameAr     String
  nameEn     String?
  category   ConsumableCategory
  unitAr     String
  unitEn     String?
  stockLevel Int               @default(0)
  lowStockThreshold Int        @default(10)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Inventory fields (dashboard stock board)
  brand        String  @default("")
  reorderStatus String @default("optimal")
  batchLot     String  @default("")
  expiryDate   String?
  locationAr   String  @default("")
  locationEn   String?
  unitCostLYD  Float   @default(0)

  usages SurgeryConsumableUsage[]

  @@map("consumable_types")
}

model SurgeryConsumableUsage {
  id              String         @id @default(cuid())
  surgeryId       String
  surgery         ScheduledSurgery @relation(fields: [surgeryId], references: [id], onDelete: Cascade)
  consumableTypeId String
  consumableType  ConsumableType  @relation(fields: [consumableTypeId], references: [id])
  quantityUsed    Int            @default(1)
  createdAt       DateTime       @default(now())

  @@unique([surgeryId, consumableTypeId])
  @@map("surgery_consumable_usage")
}

// ──────────────────────────────────────────────
// PEOPLE & CLINICAL — Epic 6
// ──────────────────────────────────────────────

enum ShiftType {
  morning
  evening
  night_call
  full_day
}

enum AttendanceStatus {
  present
  absent
  on_leave
  late
  present_ontime
  in_surgery
  on_call
}

model StaffAttendanceRecord {
  id         String           @id @default(cuid())
  staffId    String?
  staffNameAr String
  staffNameEn String?
  shiftType  ShiftType
  date       DateTime
  status     AttendanceStatus @default(present)
  checkInTime String?
  checkOutTime String?
  notesAr    String?
  notesEn    String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Personnel board fields
  roleAr      String  @default("")
  roleEn      String?
  avatar      String  @default("")
  category    StaffCategory @default(consultant)
  departmentAr String @default("")
  departmentEn String?
  shiftNameAr String  @default("")
  shiftNameEn String?
  shiftTiming String  @default("")
  scheduledTime String @default("")
  punctualityMinutes Int @default(0)
  overtimeHours Float  @default(0)
  monthlyAttendanceRate Float @default(100)
  badgeCode   String  @default("")

  @@index([date])
  @@map("staff_attendance_records")
}

model ClinicalConsultationRecord {
  id          String   @id @default(cuid())
  patientId   String
  patientNameAr String
  patientNameEn String?
  doctorNameAr String
  doctorNameEn String?
  date        DateTime
  chiefComplaintAr String?
  chiefComplaintEn String?
  diagnosisAr String?
  diagnosisEn String?
  notesAr     String?
  notesEn     String?
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // EMR fields (ophthalmic consultation template)
  ticketNumber String  @default("")
  patientAge   Int?
  patientGender Gender?
  patientPhone String  @default("")
  clinicRoom   String  @default("")
  visitDate    String?
  visitTime    String  @default("")
  status       String  @default("completed")
  visualAcuityOD_Unaided String @default("")
  visualAcuityOD_BCVA    String @default("")
  visualAcuityOS_Unaided String @default("")
  visualAcuityOS_BCVA    String @default("")
  iopOD_mmHg   Int?
  iopOS_mmHg   Int?
  corneaAr            String?
  corneaEn            String?
  anteriorChamberAr   String?
  anteriorChamberEn   String?
  lensStatusAr        String?
  lensStatusEn        String?
  fundusMaculaAr      String?
  fundusMaculaEn      String?
  icdCode             String  @default("")
  surgicalPlan        String?
  nextFollowUpDate    String?

  items OphthalmicPrescriptionItem[]

  @@index([patientId])
  @@map("clinical_consultation_records")
}

model OphthalmicPrescriptionItem {
  id             String   @id @default(cuid())
  consultationId String
  consultation   ClinicalConsultationRecord @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  odSphere  String?
  odCyl     String?
  odAxis    String?
  osSphere  String?
  osCyl     String?
  osAxis    String?
  addition  String?
  ipd       String?
  notesAr   String?
  notesEn   String?
  createdAt DateTime @default(now())

  // e-Prescription fields
  drugNameAr String  @default("")
  drugNameEn String?
  category   String  @default("lubricant")
  eye        String  @default("OU")
  dosage     String  @default("")
  frequency  String  @default("")
  durationDays Int   @default(0)
  instructionsAr String?
  instructionsEn String?
  taperingSchedule String[] @default([])

  @@map("ophthalmic_prescription_items")
}

// ──────────────────────────────────────────────
// MONEY & IMAGING — Epic 7
// ──────────────────────────────────────────────

model InsuranceProvider {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coveragePercentage Float  @default(0)
  preAuthRequired    Boolean @default(false)
  contactDesk        String  @default("")
  logo               String  @default("")

  policies InsurancePolicy[]

  @@map("insurance_providers")
}

model InsurancePolicy {
  id         String   @id @default(cuid())
  patientId  String
  patient    PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId String
  provider   InsuranceProvider @relation(fields: [providerId], references: [id])
  policyNo   String
  expiryDate DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([patientId, providerId])
  @@map("insurance_policies")
}

enum InvoiceStatus {
  pending
  paid
  partially_paid
  cancelled
  pending_insurance
  pre_auth_approved
  draft
}

model HospitalBillingInvoice {
  id         String        @id @default(cuid())
  patientId  String
  patientNameAr String?
  patientNameEn String?
  serviceAr  String
  serviceEn  String?
  amount     Decimal
  currency   String        @default("LYD")
  status     InvoiceStatus @default(pending)
  issuedDate DateTime
  paidDate   DateTime?
  notesAr    String?
  notesEn    String?
  createdBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Invoice breakdown (dashboard billing board)
  invoiceNumber String @default("")
  ticketNumber  String @default("")
  insuranceNameAr String @default("")
  insuranceNameEn String?
  surgeonFeeLYD     Float @default(0)
  orFacilityFeeLYD  Float @default(0)
  anesthesiaFeeLYD  Float @default(0)
  lensOrDeviceFeeLYD Float @default(0)
  consumablesFeeLYD  Float @default(0)
  totalGrossLYD      Float @default(0)
  insuranceCoveredLYD Float @default(0)
  patientCoPayLYD     Float @default(0)

  @@index([patientId])
  @@map("hospital_billing_invoices")
}

enum PacsOrderStatus {
  ordered
  in_progress
  completed
  cancelled
}

model DiagnosticPacsOrder {
  id          String          @id @default(cuid())
  patientId   String
  patientNameAr String
  patientNameEn String?
  examTypeAr  String
  examTypeEn  String?
  bodyPartAr  String?
  bodyPartEn  String?
  status      PacsOrderStatus @default(ordered)
  orderedByAr String
  orderedByEn String?
  orderedAt   DateTime        @default(now())
  completedAt DateTime?
  notesAr     String?
  notesEn     String?
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // PACS board fields
  orderNumber      String @default("")
  ticketNumber     String @default("")
  deviceUsed       String @default("")
  technicianAr     String @default("")
  technicianEn     String?
  findingsSummaryAr String?
  findingsSummaryEn String?
  timeCompleted    String?
  imageThumbnail   String @default("")

  @@index([patientId])
  @@map("diagnostic_pacs_orders")
}

// ──────────────────────────────────────────────
// PUBLIC CONTENT — marketing site
// ──────────────────────────────────────────────

model Testimonial {
  id          String   @id @default(cuid())
  patientNameAr String
  patientNameEn String?
  cityAr      String   @default("")
  cityEn      String?
  procedureAr String   @default("")
  procedureEn String?
  doctorAr    String   @default("")
  doctorEn    String?
  commentAr   String
  commentEn   String?
  rating      Int      @default(5)
  dateAr      String   @default("")
  dateEn      String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("testimonials")
}

model Faq {
  id        String   @id @default(cuid())
  qAr       String
  qEn       String?
  aAr       String
  aEn       String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

/// Clinical department / specialty shown on the public site.
/// `id` doubles as the slug used by Doctor.specialtyId references
/// (e.g. "refractive-lasik"). `intakeSchema` drives the per-department
/// booking form fields (Phase 2 — null means platform defaults).
model Department {
  id             String   @id
  iconName       String   @default("Sparkles")
  image          String?
  titleAr        String
  titleEn        String
  shortDescAr    String   @default("")
  shortDescEn    String   @default("")
  fullDescAr     String   @default("")
  fullDescEn     String   @default("")
  badgeAr        String   @default("")
  badgeEn        String   @default("")
  proceduresAr   String[] @default([])
  proceduresEn   String[] @default([])
  technologiesAr String[] @default([])
  technologiesEn String[] @default([])
  durationAr     String   @default("")
  durationEn     String   @default("")
  recoveryAr     String   @default("")
  recoveryEn     String   @default("")
  suitableForAr  String[] @default([])
  suitableForEn  String[] @default([])
  intakeSchema   Json?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("departments")
}

/// Technology/equipment showcase items for the public technology section.
model Technology {
  id          String   @id
  titleAr     String
  titleEn     String
  categoryAr  String   @default("")
  categoryEn  String   @default("")
  descAr      String   @default("")
  descEn      String   @default("")
  featuresAr  String[] @default([])
  featuresEn  String[] @default([])
  precision   String   @default("")
  imageSeed   String   @default("")
  image       String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("technologies")
}

model NewsletterTopic {
  id          String   @id @default(cuid())
  titleAr     String
  titleEn     String?
  icon        String   @default("Sparkles")
  frequencyAr String  @default("")
  frequencyEn String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("newsletter_topics")
}

model NewsletterIssue {
  id         String   @id @default(cuid())
  date       String   @default("")
  titleAr    String
  titleEn    String?
  categoryAr String  @default("")
  categoryEn String?
  readTimeAr String  @default("")
  readTimeEn String?
  summaryAr  String  @default("")
  summaryEn  String?
  isPublished Boolean @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("newsletter_issues")
}

model TrustStat {
  id      String   @id @default(cuid())
  value   String
  labelAr String
  labelEn String?
  icon    String   @default("CheckCircle2")
  isActive Boolean @default(true)
  sortOrder Int    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("trust_stats")
}

// ──────────────────────────────────────────────
// NEWSLETTER — BCK-025
// ──────────────────────────────────────────────

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String
  whatsapp  String?
  nameAr    String?
  nameEn    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

// ──────────────────────────────────────────────
// CONSENT — BCK-026
// ──────────────────────────────────────────────

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String
  consentType String  // "data_collection", "privacy_policy"
  consented Boolean @default(false)
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("consent_records")
}

// ──────────────────────────────────────────────
// CLIENT ERROR REPORTS — self-hosted telemetry
// ──────────────────────────────────────────────

model ClientErrorReport {
  id        String   @id @default(cuid())
  message   String
  digest    String?
  stack     String?
  locale    String?
  path      String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([digest])
  @@map("client_error_reports")
}
