// ──────────────────────────────────────────────
// PATIENT SATISFACTION — visit survey
// ──────────────────────────────────────────────

/// One satisfaction survey per visit. Identity-linked by design decision
/// (2026-09-04 grilling): rows join the account through patientRef, so the
/// survey write path requires an active consent record (BCK-026) before
/// persisting anything. One survey per ticket is DB-enforced.
model PatientSurvey {
  id           String @id @default(cuid())
  /// Visit correlation key — the appointment ticket for that visit.
  ticketNumber String @unique
  /// Account linkage (identity-linked surveys). Synthetic walk-in tickets
  /// without an account cannot submit through the authenticated endpoint.
  patientRefId String
  patientRef   PatientProfile @relation(fields: [patientRefId], references: [id], onDelete: Cascade)
  /// 1 (very poor) .. 5 (excellent)
  overallRating Int
  /// 0..10 recommendation score — feeds the NPS-style satisfaction KPI.
  recommendScore Int
  commentAr    String?
  commentEn    String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("patient_surveys")
}

