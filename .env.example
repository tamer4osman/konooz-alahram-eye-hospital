# APP_URL / NEXT_PUBLIC_SITE_URL: The public URL where this app is hosted.
# Used for self-referential links and metadata.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/konooz?schema=public"

# NOTE: session tokens are 32 random bytes (crypto.randomBytes), stored
# sha256-hashed in the sessions tables — they are not HMAC-signed, so there
# is deliberately no AUTH_SECRET. Do not re-add one unless sessions actually
# start using it (audit F9, 2026-09-08).

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Google OAuth credentials for patient sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# DPAY_*: Konooz Al-Ahram payment collection via the DPAY gateway (https://dpay.ly/docs/api).
# DPAY_BASE_URL: sandbox = https://dpay.ly/api/sandbox · live = https://dpay.ly/api
# DPAY_API_TOKEN: API token from Dashboard → API Tokens (sandbox tokens are prefixed sb_tk_).
# DPAY_WEBHOOK_SECRET: HMAC secret from Dashboard → Webhooks (per-endpoint secret, sandbox mode).
# Never commit real credentials; the webhook endpoint refuses to start without the secret.
DPAY_BASE_URL=""
DPAY_API_TOKEN=""
DPAY_WEBHOOK_SECRET=""

# Seed/demo account credentials — used only by scripts/seed-*.ts and e2e/admin.spec.ts.
# Never commit real credentials here; set actual values in .env (gitignored).
# Seed scripts fail fast if SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD are missing.
SEED_ADMIN_EMAIL="staff@konooz.test"
SEED_ADMIN_PASSWORD=""
SEED_TEST_PATIENT_EMAIL="patient@test.com"
SEED_TEST_PATIENT_PASSWORD=""
SEED_TEST_ADMIN_EMAIL="admin@test.com"
SEED_TEST_ADMIN_PASSWORD=""
SEED_TEST_CLINICIAN_EMAIL="clinician@test.com"
SEED_TEST_CLINICIAN_PASSWORD=""
# ALLOW_TEST_SEED=1   # required to run seed:test-accounts — NEVER set on production
