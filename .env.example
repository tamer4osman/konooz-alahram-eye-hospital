# APP_URL / NEXT_PUBLIC_SITE_URL: The public URL where this app is hosted.
# Used for self-referential links and metadata.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/konooz?schema=public"

# AUTH_SECRET: Secret used to sign session tokens (generate with: openssl rand -base64 32).
AUTH_SECRET=""

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: Google OAuth credentials for patient sign-in.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Seed/demo account credentials — used only by scripts/seed-*.ts and e2e/admin.spec.ts.
# Never commit real credentials here; set actual values in .env (gitignored).
# Seed scripts fail fast if SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD are missing.
SEED_ADMIN_EMAIL="staff@konooz.test"
SEED_ADMIN_PASSWORD=""
SEED_TEST_PATIENT_EMAIL="patient@test.com"
SEED_TEST_PATIENT_PASSWORD=""
SEED_TEST_ADMIN_EMAIL="admin@test.com"
SEED_TEST_ADMIN_PASSWORD=""
SEED_TEST_CLINICIAN_EMAIL="clinician@test.com"
SEED_TEST_CLINICIAN_PASSWORD=""
